# Corona Viz — Environment Variables
#
# This project currently has no required custom environment variables.
# Copy this file to .env and fill in any values you want to override.
#
# Create React App automatically sets these — do NOT define them manually:
#   NODE_ENV   = "development" | "production" | "test"  (set by react-scripts)
#   PUBLIC_URL = base URL for the /public folder          (set at build time)
#
# ----------------------------------------------------------------------------
# OPTIONAL — externalize hardcoded values (requires matching code changes)
# ----------------------------------------------------------------------------

# Novel COVID API base URL (currently hardcoded in src/constants.js)
# REACT_APP_COVID_API_URL=https://corona.lmao.ninja/v2

# Google Analytics Measurement ID (currently hardcoded in public/index.html)
# REACT_APP_GA_MEASUREMENT_ID=UA-XXXXXXXXX-X
