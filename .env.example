# -----------------------------------------------------------------------
# CoronaViz environment variables
# -----------------------------------------------------------------------
# DO NOT commit real values to source control.
# For Netlify deployments, set these in:
#   Site Settings → Environment Variables
#
# For local development with Netlify CLI:
#   cp .env.example .env
#   Fill in real values in .env (already in .gitignore)
# -----------------------------------------------------------------------

# Anthropic API key — used server-side only by netlify/functions/aiDescription.js
# NEVER prefix this with REACT_APP_; that would expose it in the browser bundle.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
